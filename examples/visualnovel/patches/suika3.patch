diff --git a/CMakeLists.txt b/CMakeLists.txt
index 767fb9ba..3b1721ab 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -592,7 +592,10 @@ if(   SUIKA_TARGET_MACOS
   # Exclude Homebrew packaging.
   #  - Homebrew provides arch-specific libraries.
   #  - If we try to make a fat binary, link will fail.
-  if(NOT SUIKA_ENABLE_DIST AND NOT SUIKA_ENABLE_DIST_CONSERVATIVE)
+  #  - Likewise with libpdot (SUIKA_WITH_PDOT, set by libpdot's
+  #    examples/visualnovel): its mbedTLS, cJSON and curl come from
+  #    Homebrew, for this Mac's architecture only.
+  if(NOT SUIKA_ENABLE_DIST AND NOT SUIKA_ENABLE_DIST_CONSERVATIVE AND NOT SUIKA_WITH_PDOT)
     set(CMAKE_OSX_ARCHITECTURES "x86_64;arm64" CACHE STRING "" FORCE)
   endif()
 endif()
